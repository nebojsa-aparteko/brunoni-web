{
  "name": "oskar-web",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@date-io/date-fns": "^1.3.11",
    "@material-ui/core": "^4.5.2",
    "@material-ui/icons": "^4.5.1",
    "@material-ui/lab": "^4.0.0-alpha.30",
    "@material-ui/pickers": "^3.2.7",
    "@types/change-case": "^2.3.1",
    "@types/classnames": "^2.2.9",
    "@types/jest": "24.0.19",
    "@types/lodash": "^4.14.144",
    "@types/node": "12.11.5",
    "@types/react": "16.9.9",
    "@types/react-dom": "16.9.2",
    "@types/react-router-dom": "^5.1.0",
    "@types/react-stickynode": "^1.4.0",
    "classnames": "^2.2.6",
    "date-fns": "^2.6.0",
    "dotenv": "^8.2.0",
    "isomorphic-fetch": "^2.2.1",
    "react": "^16.11.0",
    "react-dom": "^16.11.0",
    "react-router-dom": "^5.1.2",
    "react-scripts": "3.2.0",
    "react-stickynode": "^2.1.1",
    "typescript": "3.6.4"
  },
  "scripts": {
    "start": "REACT_APP_BRAND=$(readlink public | tail -c +8) react-scripts start",
    "build": "REACT_APP_BRAND=$(readlink public | tail -c +8) react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "prettier:base": "prettier --parser typescript --single-quote",
    "prettier:check": "npm run prettier:base -- --list-different \"src/**/*.{ts,tsx}\"",
    "prettier:write": "npm run prettier:base -- --write \"src/**/*.{ts,tsx}\"",
    "select:brunoni": "rm -f public && ln -s public.brunoni public",
    "select:allmarine": "rm -f public && ln -s public.allmarine public"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "husky": ">=1",
    "lint-staged": ">=8",
    "prettier": "^1.18.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,css,json,md}": [
      "prettier --write",
      "git add"
    ],
    "*.{ts,tsx}": [
      "prettier --parser typescript --write",
      "git add"
    ]
  }
}
