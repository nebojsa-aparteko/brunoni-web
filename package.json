  "scripts": {
    "start": "NODE_OPTIONS=--openssl-legacy-provider REACT_APP_BRAND=$(readlink public | tail -c +8) react-scripts start",
    "build": "NODE_OPTIONS=--openssl-legacy-provider REACT_APP_BRAND=$(readlink public | tail -c +8) react-scripts build",
    "build:stage": "NODE_OPTIONS=--openssl-legacy-provider REACT_APP_ENV=stage REACT_APP_BRAND=$(readlink public | tail -c +8) react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "prettier:base": "prettier --parser typescript --single-quote",
    "prettier:check": "npm run prettier:base -- --list-different \"src/**/*.{ts,tsx}\"",
    "prettier:write": "npm run prettier:base -- --write \"src/**/*.{ts,tsx}\"",
    "select:brunoni": "rm -f public && ln -s public.brunoni public",
    "select:allmarine": "rm -f public && ln -s public.allmarine public",
    "select:brunoni-allmarine": "rm -f public && ln -s public.brunoni public",
    "postinstall": "husky install"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/autosuggest-highlight": "^3.1.0",
    "@types/classnames": "^2.2.10",
    "@types/fontfaceobserver": "^0.0.6",
